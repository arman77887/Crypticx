# Database
DATABASE_URL="postgresql://user:password@localhost:5432/production_db?schema=public"

# bKash Integration Credentials (v1.2.0-beta)
BKASH_BASE_URL="https://tokenized.sandbox.bKash.com/v1.2.0-beta"
BKASH_APP_KEY="your_bkash_app_key"
BKASH_APP_SECRET="your_bkash_app_secret"
BKASH_USERNAME="your_bkash_username"
BKASH_PASSWORD="your_bkash_password"

# Nagad Integration Credentials (PGW v2)
NAGAD_BASE_URL="https://sandbox.mypay.com.bd/backend/api/dfs"
NAGAD_MERCHANT_ID="your_nagad_merchant_id"
NAGAD_PG_PUBLIC_KEY="-----BEGIN PUBLIC KEY-----\n...\n-----END PUBLIC KEY-----"
NAGAD_MERCHANT_PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----\n...\n-----END RSA PRIVATE KEY-----"

# Rocket Configuration (Disabled by default)
ROCKET_ENABLED=false
