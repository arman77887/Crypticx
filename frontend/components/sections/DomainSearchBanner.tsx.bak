"use client";

import React, { useState } from "react";
import { Globe, Search, CheckCircle2, XCircle, Loader2 } from "lucide-react";
import { useTranslation } from "@/lib/i18n/context";

type SearchStatus = "idle" | "loading" | "available" | "taken" | "error";

export const DomainSearchBanner: React.FC = () => {
  const { t } = useTranslation();

  const [domainQuery, setDomainQuery] = useState("");
  const [status, setStatus] = useState<SearchStatus>("idle");
  const [message, setMessage] = useState("");

  const normalizeDomain = (value: string) => {
    return value
      .trim()
      .toLowerCase()
      .replace(/^https?:\/\//, "")
      .replace(/^www\./, "")
      .split("/")[0];
  };

  const handleSearch = async (e: React.FormEvent) => {
    e.preventDefault();

    const domain = normalizeDomain(domainQuery);

    if (!domain || !domain.includes(".")) {
      setStatus("error");
      setMessage("Please enter a valid domain, for example: crypticx.com");
      return;
    }

    setDomainQuery(domain);
    setStatus("loading");
    setMessage("Checking domain availability...");

    try {
      /*
       * RDAP lookup.
       *
       * A 404 response normally means the domain has no registration
       * object in the registry.
       */
      const tld = domain.split(".").pop();

      if (!tld) {
        throw new Error("Invalid domain");
      }

      const rdapResponse = await fetch(
        `https://rdap.org/domain/${encodeURIComponent(domain)}`,
        {
          method: "GET",
          headers: {
            Accept: "application/rdap+json, application/json",
          },
        }
      );

      if (rdapResponse.status === 404) {
        setStatus("available");
        setMessage(`${domain} appears to be available.`);
        return;
      }

      if (rdapResponse.ok) {
        setStatus("taken");
        setMessage(`${domain} is already registered.`);
        return;
      }

      setStatus("error");
      setMessage(
        `Unable to check .${tld} right now. Please try again.`
      );
    } catch {
      setStatus("error");
      setMessage(
        "Unable to check this domain right now. Please try again."
      );
    }
  };

  return (
    <section className="relative overflow-hidden border-y border-slate-800/80 bg-slate-900 py-14 sm:py-16">
      {/* Background decoration */}
      <div className="pointer-events-none absolute inset-0">
        <div className="absolute left-1/2 top-0 h-72 w-72 -translate-x-1/2 rounded-full bg-blue-600/10 blur-3xl" />
        <div className="absolute bottom-0 left-1/4 h-48 w-48 rounded-full bg-cyan-500/5 blur-3xl" />
      </div>

      <div className="relative mx-auto max-w-5xl px-4 text-center sm:px-6 lg:px-8">
        <div className="mb-4 inline-flex items-center gap-2 rounded-full bg-cyan-500/10 px-3 py-1 text-xs font-semibold text-cyan-400">
          <Globe className="h-4 w-4" />
          <span>Domain Availability Check</span>
        </div>

        <h2 className="mb-2 text-3xl font-extrabold text-white sm:text-4xl">
          {t("domains.title")}
        </h2>

        <p className="mx-auto mb-8 max-w-2xl text-sm leading-6 text-slate-400 sm:text-base">
          {t("domains.sub")}
        </p>

        <form
          onSubmit={handleSearch}
          className="mx-auto flex max-w-3xl flex-col gap-3 sm:flex-row"
        >
          <div className="relative flex-1">
            <Search className="absolute left-4 top-1/2 h-5 w-5 -translate-y-1/2 text-slate-500" />

            <input
              type="text"
              value={domainQuery}
              onChange={(e) => {
                setDomainQuery(e.target.value);

                if (status !== "idle") {
                  setStatus("idle");
                  setMessage("");
                }
              }}
              placeholder={t("domains.search.placeholder")}
              autoComplete="off"
              className="h-14 w-full rounded-xl border border-slate-700 bg-slate-950 pl-12 pr-4 text-sm text-white placeholder-slate-500 outline-none transition focus:border-blue-500 focus:ring-2 focus:ring-blue-500/20"
            />
          </div>

          <button
            type="submit"
            disabled={status === "loading"}
            className="flex h-14 items-center justify-center gap-2 rounded-xl bg-blue-600 px-7 text-sm font-bold text-white shadow-lg shadow-blue-600/20 transition hover:bg-blue-500 disabled:cursor-not-allowed disabled:opacity-60"
          >
            {status === "loading" ? (
              <>
                <Loader2 className="h-5 w-5 animate-spin" />
                Checking...
              </>
            ) : (
              <>
                <Search className="h-5 w-5" />
                {t("domains.search.button")}
              </>
            )}
          </button>
        </form>

        {/* Result */}
        {status !== "idle" && status !== "loading" && (
          <div
            className={`mx-auto mt-5 flex max-w-3xl items-center justify-center gap-2 rounded-xl border px-4 py-3 text-sm font-medium ${
              status === "available"
                ? "border-emerald-500/30 bg-emerald-500/10 text-emerald-400"
                : status === "taken"
                  ? "border-red-500/30 bg-red-500/10 text-red-400"
                  : "border-amber-500/30 bg-amber-500/10 text-amber-400"
            }`}
          >
            {status === "available" && (
              <CheckCircle2 className="h-5 w-5 shrink-0" />
            )}

            {status === "taken" && (
              <XCircle className="h-5 w-5 shrink-0" />
            )}

            {status === "error" && (
              <XCircle className="h-5 w-5 shrink-0" />
            )}

            <span>{message}</span>
          </div>
        )}

        {/* TLD prices */}
        <div className="mt-6 flex flex-wrap items-center justify-center gap-x-6 gap-y-2 text-xs font-medium text-slate-400">
          <span>
            .com <strong className="text-white">৳1,200</strong>
          </span>

          <span>
            .net <strong className="text-white">৳1,400</strong>
          </span>

          <span>
            .org <strong className="text-white">৳1,500</strong>
          </span>

          <span>
            .xyz <strong className="text-white">৳350</strong>
          </span>

          <span>
            .bd <strong className="text-white">৳3,500</strong>
          </span>
        </div>
      </div>
    </section>
  );
};
